#include <windows.h>
1 DIALOG 30, 30, 225, 155
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Calmira CTL3D probe"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX "Controls", 100, 6, 6, 213, 140
    CONTROL "Checked option", 101, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 20, 115, 12
    EDITTEXT 102, 14, 40, 190, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LISTBOX 103, 14, 61, 190, 29, LBS_NOTIFY | WS_TABSTOP | WS_BORDER
    COMBOBOX 104, 14, 96, 190, 45, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "Radio option", 105, "BUTTON", BS_AUTORADIOBUTTON | WS_TABSTOP, 14, 119, 110, 12
END
