program RuntimePathTextTest;
{$mode delphi}{$H-}
uses SysUtils, runtime_path_text;
var Buffer: array[0..257] of Char; I, Checks: Integer; Name: string;
procedure Check(Okay: Boolean; const Text: string);
begin
  Inc(Checks);
  if not Okay then begin WriteLn('FAIL ', Text); Halt(1); end;
end;
begin
  Name := 'C:\PACKAGE\APP.EXE'; FillChar(Buffer, SizeOf(Buffer), 0);
  Move(Name[1], Buffer[0], Length(Name));
  Check(DecodeModulePath(@Buffer[0], Length(Name), SizeOf(Buffer)) = Name, 'complete module path');
  Check(DecodeModulePath(nil, 1, 2) = '', 'nil buffer');
  Check(DecodeModulePath(@Buffer[0], 0, SizeOf(Buffer)) = '', 'failed API');
  Check(DecodeModulePath(@Buffer[0], -1, SizeOf(Buffer)) = '', 'negative count');
  Check(DecodeModulePath(@Buffer[0], Length(Name), 0) = '', 'zero capacity');
  Check(DecodeModulePath(@Buffer[0], Length(Name), -1) = '', 'negative capacity');
  Check(DecodeModulePath(@Buffer[0], Length(Name), Length(Name)) = '', 'no room for terminator');
  Buffer[Length(Name)] := 'X';
  Check(DecodeModulePath(@Buffer[0], Length(Name), SizeOf(Buffer)) = '', 'missing terminator');
  Buffer[Length(Name)] := #0; Buffer[3] := #0;
  Check(DecodeModulePath(@Buffer[0], Length(Name), SizeOf(Buffer)) = '', 'embedded NUL');
  FillChar(Buffer, SizeOf(Buffer), Ord('A')); Buffer[255] := #0;
  Name := DecodeModulePath(@Buffer[0], 255, SizeOf(Buffer));
  Check((Length(Name) = 255) and (Name[255] = 'A'), 'maximum complete ShortString');
  Check(DecodeModulePath(@Buffer[0], 255, 255) = '', 'maximum name requires terminator capacity');
  Buffer[255] := 'A'; Buffer[256] := #0;
  Check(DecodeModulePath(@Buffer[0], 256, SizeOf(Buffer)) = '', 'overlong name rejected before narrowing');
  Check(DecodeModulePath(@Buffer[0], 257, SizeOf(Buffer)) = '', 'truncated return count');
  Check(IsRootedDriveFileName('C:\APP.EXE'), 'rooted drive file');
  Check(IsRootedDriveFileName('d:\Program Files\app.exe'), 'spaces and lower-case drive');
  for I := 0 to 3 do
    Check(not IsRootedDriveFileName(Copy('C:\', 1, I)), 'short sidecar path');
  Check(not IsRootedDriveFileName('C:APP.EXE'), 'drive-relative path');
  Check(not IsRootedDriveFileName('\APP.EXE'), 'root-relative path');
  Check(not IsRootedDriveFileName('..\APP.EXE'), 'relative path');
  Check(not IsRootedDriveFileName('C:/APP.EXE'), 'non-wrapper separator');
  Check(not IsRootedDriveFileName('1:\APP.EXE'), 'invalid drive');
  Check(not IsRootedDriveFileName('C:\PKG\'), 'directory instead of file');
  Check(not IsRootedDriveFileName('C:\APP.EXE' + #0 + 'ignored'), 'sidecar NUL');
  Check(not IsRootedDriveFileName('\\server\share\APP.EXE'), 'UNC outside wrapper contract');
  Name := 'C:\PKG\APP.EXE'; FillChar(Buffer, SizeOf(Buffer), 0);
  Move(Name[1], Buffer[0], Length(Name));
  Check(DecodeSourcePath(@Buffer[0], Length(Name), SizeOf(Buffer)) = Name, 'sidecar without newline');
  Buffer[Length(Name)] := #13; Buffer[Length(Name) + 1] := #10;
  Check(DecodeSourcePath(@Buffer[0], Length(Name) + 2, SizeOf(Buffer)) = Name, 'sidecar CRLF');
  Buffer[Length(Name)] := #10;
  Check(DecodeSourcePath(@Buffer[0], Length(Name) + 1, SizeOf(Buffer)) = Name, 'sidecar LF');
  Buffer[5] := #10;
  Check(DecodeSourcePath(@Buffer[0], Length(Name), SizeOf(Buffer)) = '', 'sidecar multiline rejected');
  Check(DecodeSourcePath(nil, 1, 2) = '', 'nil sidecar buffer');
  Check(DecodeSourcePath(@Buffer[0], 0, SizeOf(Buffer)) = '', 'empty sidecar');
  Check(DecodeSourcePath(@Buffer[0], -1, SizeOf(Buffer)) = '', 'failed sidecar read');
  Check(DecodeSourcePath(@Buffer[0], SizeOf(Buffer), SizeOf(Buffer)) = '', 'truncated sidecar read');
  FillChar(Buffer, SizeOf(Buffer), Ord('A'));
  Buffer[0] := 'C'; Buffer[1] := ':'; Buffer[2] := '\';
  Check(Length(DecodeSourcePath(@Buffer[0], 255, SizeOf(Buffer))) = 255, 'maximum sidecar path');
  Check(DecodeSourcePath(@Buffer[0], 256, SizeOf(Buffer)) = '', 'overlong sidecar path');
  Buffer[255] := #13; Buffer[256] := #10;
  Check(Length(DecodeSourcePath(@Buffer[0], 257, SizeOf(Buffer))) = 255, 'maximum sidecar plus CRLF');
  Check(ExecutableDirectory('C:\APP.EXE') = 'C:\', 'root executable directory');
  Check(ExecutableDirectory('C:\PKG\APP.EXE') = 'C:\PKG\', 'nested executable directory');
  Check(ExecutableDirectory('APP.EXE') = '', 'unqualified executable directory');
  Check(ExecutableDirectory('\\server\share\APP.EXE') = '\\server\share\', 'UNC module directory');
  Check(IsWrapperModuleName('C:\TEMP\UPX123.EXE'), 'UPX module prefix');
  Check(IsWrapperModuleName('C:\TEMP\~upx123.exe'), 'tilde lower-case module prefix');
  Check(not IsWrapperModuleName('C:\UPX\APP.EXE'), 'prefix belongs to basename only');
  Check(not IsWrapperModuleName('C:\TEMP\UP.EXE'), 'short module prefix rejected');
  Check(WrapperSidecarFileName('C:\TEMP\UPX123.EXE') = 'C:\TEMP\UPX123.SRC', 'sidecar extension replacement');
  Check(WrapperSidecarFileName('C:\TEMP\UPX123') = 'C:\TEMP\UPX123.SRC', 'extensionless module sidecar');
  Check(WrapperSidecarFileName('C:\A.B\UPX123') = 'C:\A.B\UPX123.SRC', 'directory dots are not extensions');
  Check(WrapperSidecarFileName('') = '', 'empty module has no sidecar');
  Name := 'C:\' + StringOfChar('A', 249);
  Check(WrapperSidecarFileName(Name) = '', 'sidecar extension overflow rejected');
  Name := 'C:\' + StringOfChar('A', 248) + '.EXE';
  Check(Length(WrapperSidecarFileName(Name)) = 255, 'maximum sidecar filename');
  WriteLn('runtime path text tests: ', Checks, ' passed');
end.
