                                TExternalLinkerWin16WLink
 ****************************************************************************}
 
+{ The startup code: prt0<model> for programs; libraries need their own
+  entry code (dllprt0<model>), which must not start a task. }
+function StartupObjectName(isdll: boolean): string;
+begin
+  case current_settings.x86memorymodel of
+    mm_small:   Result:='prt0s';
+    mm_medium:  Result:='prt0m';
+    mm_compact: Result:='prt0c';
+    mm_large:   Result:='prt0l';
+    mm_huge:    Result:='prt0h';
+    else
+      internalerror(2019061501);
+  end;
+  if isdll then
+    Result:='dll'+Result;
+end;
