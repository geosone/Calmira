diff -ruN a/rtl/win16/prt0comn.asm b/rtl/win16/prt0comn.asm
--- a/rtl/win16/prt0comn.asm
+++ b/rtl/win16/prt0comn.asm
@@ -54,6 +54,101 @@
                 extern __AHIncr
                 import __AHIncr KERNEL
 
+;; Libraries get their own entry code instead of the task startup below.
+%ifdef __DLL__
+                extern LocalInit
+                import LocalInit KERNEL
+                extern FPC_LIB_EXIT
+
+..start:        ; Win16 libraries start with the following values in registers:
+                ;
+                ; CX = the size, in bytes, of the local heap
+                ; DI = handle, identifying the library instance
+                ; DS = segment of the automatic data segment for the library
+                ; ES:SI = the command line
+                ;
+                ; The library runs on the stack of the task that loads it
+                ; (SS <> DS) and returns AX = 1 on success, AX = 0 on failure.
+                push si
+                push di
+                push ds
+                push es
+                jcxz .heap_done
+                ; a library initializes its local heap itself
+                push ds
+                xor ax, ax
+                push ax
+                push cx
+                call far LocalInit
+                test ax, ax
+                jz .init_failed
+.heap_done:
+                pop es
+%ifdef __HUGE__
+                ; the system unit's variables live in its own data segment
+%macro set_unit_var 3
+                mov cx, seg %1
+                mov ds, cx
+                mov word [%1+%2], %3
+%endmacro
+%else
+%macro set_unit_var 3
+                mov word [%1+%2], %3
+%endmacro
+%endif
+                ; a library has no PSP; the system unit derives IsLibrary from this
+                set_unit_var __fpc_PrefixSeg, 0, 0
+                set_unit_var __fpc_CmdLine, 2, es
+                set_unit_var __fpc_CmdLine, 0, si
+                set_unit_var __fpc_CmdShow, 0, 0
+                set_unit_var __fpc_HInstance, 0, di
+                set_unit_var __fpc_HPrevInst, 0, 0
+                set_unit_var __fpc_SelectorInc, 0, __AHIncr
+                pop ds
+                push ds
+
+                ; initialize the units and run the library's main block
+%ifdef __FAR_CODE__
+                call far PASCALMAIN
+%else
+                call PASCALMAIN
+%endif
+                mov ax, 1
+                jmp .done
+.init_failed:
+                pop es
+                xor ax, ax
+.done:
+                pop ds
+                pop di
+                pop si
+                retf
+
+
+                ; WEP(nExitType: Integer): Integer; far; pascal
+                ; Windows calls it before it unloads the library.
+                global WEP
+                export WEP WEP resident
+WEP:
+                push si
+                push di
+                push ds
+                mov ax, DGROUP
+                mov ds, ax
+                ; run the exit procedures and the units' finalization
+%ifdef __FAR_CODE__
+                call far FPC_LIB_EXIT
+%else
+                call FPC_LIB_EXIT
+%endif
+                pop ds
+                pop di
+                pop si
+                mov ax, 1
+                retf 2
+
+%else
+
 ..start:        ; Win16 applications start with the following
                 ; values in registers:
                 ;
@@ -143,6 +238,7 @@
