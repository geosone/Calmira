@@ -1148,16 +1148,33 @@
 {   LoadStr returns the string resource Ident.   }
 
 function LoadStr(Ident: integer): string;
+{$ifdef CALMIRA_WIN16_DELPHI1_RESOURCES}
+var
+  Buffer: array[0..255] of Char;
+  Len: SmallInt;
+begin
+  { Delphi 1 loads the string from the module's string table. }
+  Len:=LoadString(HInstance,Word(Ident),@Buffer[0],SizeOf(Buffer));
+  if Len<0 then
+    Len:=0;
+  SetString(result,@Buffer[0],Len);
+end;
+{$else CALMIRA_WIN16_DELPHI1_RESOURCES}
 begin
   result:='';
 end;
+{$endif CALMIRA_WIN16_DELPHI1_RESOURCES}
 
 {   FmtLoadStr returns the string resource Ident and formats it accordingly   }
 
 
 function FmtLoadStr(Ident: integer; const Args: array of const): string;
 begin
+{$ifdef CALMIRA_WIN16_DELPHI1_RESOURCES}
+  result:=Format(LoadStr(Ident),Args);
+{$else CALMIRA_WIN16_DELPHI1_RESOURCES}
   result:='';
+{$endif CALMIRA_WIN16_DELPHI1_RESOURCES}
 end;
 
