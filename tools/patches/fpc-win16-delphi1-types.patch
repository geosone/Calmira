--- a/rtl/win16/winprocs.inc
+++ b/rtl/win16/winprocs.inc
@@ -103,3 +103,19 @@
 begin
   PALETTEINDEX := COLORREF(DWORD($01000000) or DWORD(wPaletteIndex));
 end;
+
+{$if defined(CALMIRA_WIN16_DELPHI1_TYPES) and not defined(SYSTEMUNIT)}
+function PtInRect(lprc: LPRECT; pt: TPoint): BOOL;
+begin
+  PtInRect := (pt.x >= lprc^.left) and (pt.x < lprc^.right) and
+    (pt.y >= lprc^.top) and (pt.y < lprc^.bottom);
+end;
+
+{$ifdef VAR_PARAMS_ARE_FAR}
+function PtInRect(const rc: TRect; pt: TPoint): BOOL;
+begin
+  PtInRect := (pt.x >= rc.left) and (pt.x < rc.right) and
+    (pt.y >= rc.top) and (pt.y < rc.bottom);
+end;
+{$endif VAR_PARAMS_ARE_FAR}
+{$endif}
