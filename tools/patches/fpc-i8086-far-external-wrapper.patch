+  procedure thlcgcpu.g_external_wrapper(list: TAsmList; procdef: tprocdef; const wrappername, externalname: string; global: boolean);
+    var
+      sym: tasmsymbol;
+    begin
+      if not is_proc_far(procdef) then
+        begin
+          inherited;
+          exit;
+        end;
+      maybe_new_object_file(list);
+      new_section(list,sec_code,wrappername,target_info.alignment.procalign);
+      if global then
+        begin
+          sym:=current_asmdata.DefineAsmSymbol(wrappername,AB_GLOBAL,AT_FUNCTION,procdef);
+          list.concat(Tai_symbol.Create_global(sym,0));
+        end
+      else
+        begin
+          sym:=current_asmdata.DefineAsmSymbol(wrappername,AB_PRIVATE_EXTERN,AT_FUNCTION,procdef);
+          list.concat(Tai_symbol.Create(sym,0));
+        end;
+      list.concat(taicpu.op_sym(A_JMP,S_FAR,current_asmdata.RefAsmSymbol(externalname,AT_FUNCTION)));
+      list.concat(Tai_symbol_end.Create(sym));
+    end;
