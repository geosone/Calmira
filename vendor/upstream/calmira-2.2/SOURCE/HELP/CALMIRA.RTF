\par \pard\plain \s2\keepn \b\f2\cf2\lang2057 \page {\plain \f3\fs16\up6\lang2057 #{\footnote \pard\plain \s245 \f3\fs20\lang2057 {\fs16\up6 #} QandA}} {\plain \f3\fs16\up6\lang2057 ${\footnote \pard\plain \s245 \f3\fs20\lang2057 {\fs16\up6 $}
 Calmira Questions and Answers}} {\plain \f3\fs16\up6\lang2057 K{\footnote \pard\plain \s245 \f3\fs20\lang2057 {\fs16\up6 K}
